# Base de datos (SQLite en disco; en servidor usa ruta absoluta persistente)
DATABASE_URL="file:./prisma/dev.db"

# Obligatorio en producción: cadena larga aleatoria (openssl rand -base64 32)
AUTH_SECRET="cambia-esta-clave-por-una-larga-y-propia"

# Correo del taller que alimenta la página pública (debe existir en la tabla Carpenter)
SHOP_EMAIL="taller@jacm-carpinteria.local"

# Opcional: puerto al arrancar con next start (default 3010)
# PORT=3010
# NODE_ENV=production